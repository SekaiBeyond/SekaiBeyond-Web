{
  "name": "sekaibeyondweb",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix functions run build && react-router build",
    "update-csp-hashes": "node scripts/update-csp-hashes.ts",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "deploy": "npm run build && npm run update-csp-hashes && firebase deploy --config firebase.generated.json",
    "deploy:rules": "npm --prefix functions run build && firebase deploy --only functions,firestore,storage"
  },
  "dependencies": {
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@vis.gl/react-google-maps": "^1.10.0",
    "firebase": "^12.19.0",
    "isbot": "^5.2.2",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
