{
  "name": "sekaibeyondweb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc && tsc -p functions --noEmit",
    "build": "npm --prefix functions run build && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "update-csp-hashes": "node scripts/update-csp-hashes.ts",
    "deploy": "npm run build && npm run update-csp-hashes && node scripts/deploy-functions.ts && firebase deploy --config firebase.generated.json --except functions",
    "deploy:functions": "npm --prefix functions run build && node scripts/deploy-functions.ts",
    "deploy:rules": "npm run deploy:functions && firebase deploy --only firestore,storage"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "firebase": "^12.19.0",
    "isbot": "^5.2.2",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.14.0",
    "marked": "^18.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
