# Origin used to build ticket-claim URLs embedded in QR codes
# (sendTicketEmails -> {PUBLIC_ORIGIN}/claim?ticket=X&event=Y).
# Defaults to https://sekaibeyond.com in code. Forks MUST override this or
# their tickets will point at the original deployment. An explicit empty
# value (PUBLIC_ORIGIN=) still trips sendTicketEmails' failed-precondition
# guard, so leaving this unset is safer than blanking it.
PUBLIC_ORIGIN=https://your-site.example.com

# Optional. Per-day cap on outgoing ticket emails (matches the email provider's
# tier). Enforced server-side in sendTicketEmails. Default: 100.
# RESEND_DAILY_CAP=100

# Optional. Max attendees processed per sendTicketEmails invocation. The client
# loops with cursor/drain pagination. Default: 100.
# SEND_CHUNK_SIZE=100

# Optional. Max attendee rows per importEventAttendees call. Default: 1000.
# IMPORT_MAX_ROWS=1000
