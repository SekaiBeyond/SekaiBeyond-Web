rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        function callerGroup() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group;
        }

        function callerEventStaffEvents() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('eventStaffEvents', []);
        }

        function isCoreStaffOrAbove() {
            return callerGroup() in ['core-staff', 'president'];
        }

        function isStaffOrAbove() {
            return callerGroup() in ['staff', 'core-staff', 'president'];
        }

        function isEventStaffFor(eventId) {
            return eventId in callerEventStaffEvents();
        }

        // The caller's sign-in, as a row in their device list: users/{uid}/sessions,
        // named by the token's auth_time (see functions/src/utils/sessions.ts).
        // Signing a device out only marks its row, and its token goes on working
        // with Firebase Auth, so reads check the row here as requireAuth does for
        // calls: refused once it's ended, and refused without one once 600 seconds
        // (UNLISTED_GRACE_SECONDS) have passed since signing in, the time a new
        // device has to list itself (touchSession), or if it began before the
        // account's devices were last signed out (signedInSinceSessionsEnded).
        function liveSession() {
            let session = /databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(string(request.auth.token.auth_time));
            return exists(session)
                ? get(session).data.get('endedAt', null) == null
                : request.time.toMillis() < (request.auth.token.auth_time + 600) * 1000
                    && signedInSinceSessionsEnded();
        }

        // When the caller's sign-in began, in milliseconds: the earlier of when
        // the functions made its token (mintedAt) and its auth_time, or its
        // auth_time alone for Firebase Auth's own providers. A custom-token one
        // that doesn't say counts as the oldest.
        function signInBeganMillis() {
            let authMillis = request.auth.token.auth_time * 1000;
            let mintedAt = request.auth.token.get('mintedAt',
                request.auth.token.firebase.sign_in_provider == 'custom' ? 0 : authMillis);
            return mintedAt < authMillis ? mintedAt : authMillis;
        }

        // Whether the caller's sign-in began after `sessionsEndedAt` on their
        // user doc, the last time all their devices were signed out. Only asked
        // of a sign-in with no row.
        function signedInSinceSessionsEnded() {
            let user = /databases/$(database)/documents/users/$(request.auth.uid);
            return !exists(user)
                || get(user).data.get('sessionsEndedAt', null) == null
                || signInBeganMillis() > get(user).data.sessionsEndedAt.toMillis();
        }

        function signedIn() {
            return request.auth != null && liveSession();
        }

        match /users/{userId} {
            // Users can read their own profile; staff+ can read any profile.
            // Event-staff can read profiles of users who share at least one staff event with them
            // (needed for the event staff list in the admin panel).
            // Other users' public data is served via the getPublicProfile Cloud Function
            // to avoid exposing email to all authenticated users.
            allow read: if signedIn()
                && (request.auth.uid == userId
                    || isStaffOrAbove()
                    || (callerEventStaffEvents().size() > 0
                        && resource.data.get('eventStaffEvents', []).hasAny(callerEventStaffEvents())));

            // All user mutations (displayName, photoURL, bannerURL, badges, attendedEvents, group,
            // membershipExpiresAt, membershipStartedAt) via Cloud Functions

            // The devices signed in to this account. Only the owner reads them:
            // the Settings tab lists them, and each device watches its own so it
            // signs out when ended from another, which is why this alone doesn't
            // ask for signedIn(): an ended device has to read its row to see it.
            // Writes via Cloud Functions (touchSession, endSession,
            // endOtherSessions, endAllSessions) only.
            match /sessions/{sessionId} {
                allow read: if request.auth != null && request.auth.uid == userId;
            }
        }

        // Activity records — staff+ can read only; all writes via Cloud Functions
        match /records/{recordId} {
            allow read: if signedIn()
                && isStaffOrAbove();
        }

        // Event check-in codes — staff+ can read only; all mutations via Cloud Functions
        match /claimCodes/{codeId} {
            allow read: if signedIn()
                && isStaffOrAbove();
        }

        // Achievement badge definitions — readable by any logged-in user; all writes via Cloud Functions
        match /badges/{badgeId} {
            allow read: if signedIn();
        }

        // Badge activation codes — core-staff+ can read only; all mutations via Cloud Functions
        match /badgeActivationCodes/{codeId} {
            allow read: if signedIn()
                && isCoreStaffOrAbove();
        }

        // Staff claim codes — core-staff+ can read only; all mutations via Cloud Functions
        match /staffClaimCodes/{codeId} {
            allow read: if signedIn()
                && isCoreStaffOrAbove();
        }

        // Event labels — publicly readable; all writes via Cloud Functions
        match /eventLabels/{labelId} {
            allow read: if true;
        }

        // Past events — publicly readable; all writes via Cloud Functions
        match /pastEvents/{eventId} {
            allow read: if true;

            // Paid event subcollections, moved here from upcomingEvents on archive.
            // Staff+ read every event's attendees (staff read-only in the panel);
            // event-staff read only their own events'.
            match /attendees/{attendeeId} {
                allow read: if signedIn()
                    && (isStaffOrAbove() || isEventStaffFor(eventId));
            }
            match /emailTemplate/{docId} {
                allow read: if signedIn()
                    && isCoreStaffOrAbove();
            }
        }

        // Rate-limit counters — server-only, no client access
        match /rateLimits/{uid} {
            allow read, write: if false;
        }

        // API keys, stored under their hashes, each belonging to a registered app.
        // Server-only, no exceptions — core staff list, create, rename and revoke
        // them through listApps, createApiKey, renameApiKey and revokeApiKey, and
        // the API reads them to check a caller's key.
        match /apiKeys/{keyId} {
            allow read, write: if false;
        }

        // Apps people sign in to with their accounts here (functions/src/utils/apps.ts).
        // Server-only: core staff manage them through listApps, saveApp and
        // deleteApp, and sign-in and the API read them.
        match /apps/{appId} {
            allow read, write: if false;
        }

        // One-time sign-in codes /authorize hands apps, stored hashed, until
        // the app trades one at /api/v1/token (issueSignInCode). Server-only.
        match /appSignInCodes/{codeHash} {
            allow read, write: if false;
        }

        // How accounts sign in: password hashes and bound Google accounts, kept
        // off users/{uid} because all staff can read that. Server-only, no
        // exceptions, and the two indexes below are what make an address and a
        // Google account belong to one account each.
        match /credentials/{uid} {
            allow read, write: if false;
        }
        match /emailIndex/{emailHash} {
            allow read, write: if false;
        }
        match /googleIndex/{googleSub} {
            allow read, write: if false;
        }

        // Codes emailed to prove an address, stored hashed. Server-only.
        match /emailCodes/{codeId} {
            allow read, write: if false;
        }

        // "This wasn't me" links, stored hashed. Server-only.
        match /emailUndos/{undoId} {
            allow read, write: if false;
        }

        // How many scans one client has already added to one QR code in the
        // current window, so a looped public scan endpoint can't run a counter up
        // forever. Server-only, and the ids are salted hashes — there is nothing
        // here to read even for a president.
        match /scanQuota/{slot} {
            allow read, write: if false;
        }

        // Scheduled-mail overflow queue — core-staff+ can read for visibility;
        // writes via Cloud Functions only. Drained every 30 minutes by the
        // scheduledMailDrain function.
        match /scheduledMail/{docId} {
            allow read: if signedIn()
                && isCoreStaffOrAbove();
        }

        // Upcoming events — public can read only published ones; staff+ can read all;
        // event-staff can read events they are assigned to.
        // All writes via Cloud Functions.
        match /upcomingEvents/{eventId} {
            allow read: if resource.data.published == true
                || (signedIn() && isStaffOrAbove())
                || (signedIn() && isEventStaffFor(eventId));

            // Paid event subcollections. Staff+ read every event's attendees
            // (staff read-only in the panel); event-staff read only their own events'.
            match /attendees/{attendeeId} {
                allow read: if signedIn()
                    && (isStaffOrAbove() || isEventStaffFor(eventId));
            }
            match /emailTemplate/{docId} {
                allow read: if signedIn()
                    && isCoreStaffOrAbove();
            }
            // Door settings, kept off the public event doc. Read by whoever
            // scans, so the scanner can say how unlisted tickets are treated.
            match /settings/{docId} {
                allow read: if signedIn()
                    && (isStaffOrAbove() || isEventStaffFor(eventId));
            }
        }

        // Policy page content — publicly readable; writes via Cloud Functions
        match /policy/{docId} {
            allow read: if true;
        }

        // Con page copy (schedule, café, tickets, ...) — writes via saveConContent.
        //
        // Split in two so that "unpublished" means the content is not on the public
        // web, not merely that the page declines to draw it:
        //   main  — the published mirror. Public, and written only while the con is
        //           published; unpublishing deletes it.
        //   draft — what the admin panel edits and staff preview. Staff+ only,
        //           so an unannounced line-up is not readable by querying directly.
        // Any other document here is server-only.
        match /conContent/main {
            allow read: if true;
        }
        match /conContent/draft {
            allow read: if signedIn()
                && isStaffOrAbove();
        }

        // Site config (team, contact and social links, etc.) — publicly readable; writes via Cloud Functions.
        // config/main.teamMembers holds ONLY a display projection (no account uid/flags).
        // The full team roster (with linked-account uids) lives in the server-only
        // `teamRoster` collection below.
        match /config/{docId} {
            allow read: if true;
        }

        // Full team roster (display fields + linked-account uid/follow flags).
        // Server-only: the editor reads it via the getTeamRoster function (staff+) and
        // all writes go through saveTeamMembers. Keeping account uids out of the public
        // config/main doc is the whole point — do NOT open this up to client reads.
        match /teamRoster/{docId} {
            allow read, write: if false;
        }

        // Event venues (parking guide data) — publicly readable; writes via Cloud Functions
        match /venues/{venueId} {
            allow read: if true;
        }

        // The parking guide's synced copy of UW's lots, event pricing, walking times
        // and venue outlines (uwParking/current). Publicly readable; written only by
        // the sync functions.
        match /uwParking/{docId} {
            allow read: if true;
        }

        // Managed QR codes — staff+ can read for the admin dashboard / link flow.
        // Public scanners never read these directly; they hit the recordQrScan
        // Cloud Function, which returns the redirect target. All writes (and the
        // scan counters) go through Cloud Functions.
        match /qrCodes/{qrId} {
            allow read: if signedIn() && isStaffOrAbove();

            // Per-scan events backing the trend charts.
            match /scans/{scanId} {
                allow read: if signedIn() && isStaffOrAbove();
            }
        }

        // Physical passports. Staff+ read the whole collection for the admin
        // dashboard; an owner may read their own passports (the profile shelf),
        // which is why the shelf query MUST filter on ownerUid — an unfiltered
        // read is rejected. Public scanners never read this: they call
        // getPassportPublicProfile, which resolves the sticker server-side.
        // All writes (status, ownerUid) go through Cloud Functions.
        match /passports/{passportId} {
            allow read: if signedIn()
                && (isStaffOrAbove() || resource.data.ownerUid == request.auth.uid);
        }

        // Activation keys and their hashes. Server-only, no exceptions — an
        // unsold passport's key never comes off the wire from a client read.
        // Admins see one through revealPassportKey, which logs every look.
        // Same treatment as teamRoster.
        match /passportSecrets/{passportId} {
            allow read, write: if false;
        }

        // Staff's notes on passports, such as why one was made. Apart from
        // the passport because its holder can read that; staff+ read these
        // (staff read-only in the panel), and writes go through the functions.
        match /passportNotes/{passportId} {
            allow read: if signedIn() && isStaffOrAbove();
        }

        // Passport designs — a name, a year, and cover art; a year can have
        // several. Publicly readable: a signed-out visitor scanning a sticker
        // needs the name and artwork, and it holds nothing that isn't already
        // printed on the passport.
        match /passportDesigns/{designId} {
            allow read: if true;
        }

        // The email that sends a passport's key — core-staff+ can read, like
        // the ticket templates; writes via updatePassportEmailTemplate only.
        match /passportEmailTemplate/{docId} {
            allow read: if signedIn()
                && isCoreStaffOrAbove();
        }

        // Editable social-platform templates for the QR "Social profile" mode.
        // Only consumed in the admin UI (staff+), never by public scanners; all
        // writes go through Cloud Functions.
        match /socialPlatforms/{platformId} {
            allow read: if signedIn() && isStaffOrAbove();
        }

        // Deny all access to unlisted paths (safety net — Firestore denies by default,
        // but an explicit rule prevents accidental exposure if new paths are added)
        match /{document=**} {
            allow read, write: if false;
        }
    }
}
