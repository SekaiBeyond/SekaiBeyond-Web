rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function getUserGroup() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group;
    }

    function isCoreStaffOrAbove() {
      return getUserGroup() in ['core-staff', 'president'];
    }

    match /users/{userId} {
      // Authenticated users can read any profile
      allow read: if request.auth != null;

      // Users can create their own profile (group must be 'visitor')
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.group == 'visitor';

      // Users can update their own displayName and photoURL only
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);

      // Users can claim badges (add one event to attendedEvents, nothing else)
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendedEvents'])
                    && request.resource.data.attendedEvents.toSet().hasAll(resource.data.attendedEvents)
                    && request.resource.data.attendedEvents.size() == resource.data.attendedEvents.size() + 1;

      // Core-staff can update any user, but cannot assign president
      // Only president can assign president
      allow update: if request.auth != null
                    && isCoreStaffOrAbove()
                    && (getUserGroup() == 'president'
                        || request.resource.data.group in ['visitor', 'member', 'staff', 'core-staff']);
    }

    // Activity records — core-staff+ can read, create only (no edit/delete), must be own uid
    match /records/{recordId} {
      allow read: if request.auth != null
                  && isCoreStaffOrAbove();
      allow create: if request.auth != null
                    && isCoreStaffOrAbove()
                    && request.resource.data.performedBy == request.auth.uid;
    }

    // Badge claim codes — generated by admins, read by any logged-in user to claim badges
    match /badgeCodes/{codeId} {
      // Any logged-in user can read (needed to look up claim codes)
      allow read: if request.auth != null;

      // Only core-staff and president can create, update, or delete codes
      allow write: if request.auth != null
                   && isCoreStaffOrAbove();
    }
  }
}
