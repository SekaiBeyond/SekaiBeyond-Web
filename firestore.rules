rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        function callerGroup() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group;
        }

        function callerEventStaffEvents() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('eventStaffEvents', []);
        }

        function isCoreStaffOrAbove() {
            return callerGroup() in ['core-staff', 'president'];
        }

        function isStaffOrAbove() {
            return callerGroup() in ['staff', 'core-staff', 'president'];
        }

        function isEventStaffFor(eventId) {
            return eventId in callerEventStaffEvents();
        }

        match /users/{userId} {
            // Users can read their own profile; staff+ can read any profile.
            // Event-staff can read profiles of users who share at least one staff event with them
            // (needed for the event staff list in the admin panel).
            // Other users' public data is served via the getPublicProfile Cloud Function
            // to avoid exposing email to all authenticated users.
            allow read: if request.auth != null
                && (request.auth.uid == userId
                    || isStaffOrAbove()
                    || (callerEventStaffEvents().size() > 0
                        && resource.data.get('eventStaffEvents', []).hasAny(callerEventStaffEvents())));

            // All user mutations (displayName, photoURL, badges, attendedEvents, group,
            // membershipExpiresAt) via Cloud Functions
        }

        // Activity records — staff+ can read only; all writes via Cloud Functions
        match /records/{recordId} {
            allow read: if request.auth != null
                && isStaffOrAbove();
        }

        // Event/badge claim codes — staff+ can read only; all mutations via Cloud Functions
        match /claimCodes/{codeId} {
            allow read: if request.auth != null
                && isStaffOrAbove();
        }

        // Achievement badge definitions — readable by any logged-in user; all writes via Cloud Functions
        match /badges/{badgeId} {
            allow read: if request.auth != null;
        }

        // Badge activation codes — core-staff+ can read only; all mutations via Cloud Functions
        match /badgeActivationCodes/{codeId} {
            allow read: if request.auth != null
                && isCoreStaffOrAbove();
        }

        // Staff claim codes — core-staff+ can read only; all mutations via Cloud Functions
        match /staffClaimCodes/{codeId} {
            allow read: if request.auth != null
                && isCoreStaffOrAbove();
        }

        // Event labels — publicly readable; all writes via Cloud Functions
        match /eventLabels/{labelId} {
            allow read: if true;
        }

        // Past events — publicly readable; all writes via Cloud Functions
        match /pastEvents/{eventId} {
            allow read: if true;

            // Paid event subcollections (migrated from upcomingEvents on archive)
            match /attendees/{attendeeId} {
                allow read: if request.auth != null
                    && (isCoreStaffOrAbove() || isEventStaffFor(eventId));
            }
            match /emailTemplate/{docId} {
                allow read: if request.auth != null
                    && isCoreStaffOrAbove();
            }
        }

        // Rate-limit counters — server-only, no client access
        match /rateLimits/{uid} {
            allow read, write: if false;
        }

        // Scheduled-mail overflow queue — core-staff+ can read for visibility;
        // writes via Cloud Functions only. Drained at 00:05 LA by the
        // scheduledMailDrain function.
        match /scheduledMail/{docId} {
            allow read: if request.auth != null
                && isCoreStaffOrAbove();
        }

        // Upcoming events — public can read only published ones; staff+ can read all;
        // event-staff can read events they are assigned to.
        // All writes via Cloud Functions.
        match /upcomingEvents/{eventId} {
            allow read: if resource.data.published == true
                || (request.auth != null && isStaffOrAbove())
                || (request.auth != null && isEventStaffFor(eventId));

            // Paid event subcollections
            match /attendees/{attendeeId} {
                allow read: if request.auth != null
                    && (isCoreStaffOrAbove() || isEventStaffFor(eventId));
            }
            match /emailTemplate/{docId} {
                allow read: if request.auth != null
                    && isCoreStaffOrAbove();
            }
        }

        // Policy page content — publicly readable; writes via Cloud Functions
        match /policy/{docId} {
            allow read: if true;
        }

        // Con page copy (schedule, guests, tickets, ...) — writes via saveConContent.
        //
        // Split in two so that "unpublished" means the content is not on the public
        // web, not merely that the page declines to draw it:
        //   main  — the published mirror. Public, and written only while the con is
        //           published; unpublishing deletes it.
        //   draft — what the admin panel edits and core staff preview. Staff+ only,
        //           so an unannounced line-up is not readable by querying directly.
        // Any other document here is server-only.
        match /conContent/main {
            allow read: if true;
        }
        match /conContent/draft {
            allow read: if request.auth != null
                && isStaffOrAbove();
        }

        // Site config (featured video, etc.) — publicly readable; writes via Cloud Functions.
        // config/main.teamMembers holds ONLY a display projection (no account uid/flags).
        // The full team roster (with linked-account uids) lives in the server-only
        // `teamRoster` collection below.
        match /config/{docId} {
            allow read: if true;
        }

        // Full team roster (display fields + linked-account uid/follow flags).
        // Server-only: the editor reads it via the getTeamRoster function (staff+) and
        // all writes go through saveTeamMembers. Keeping account uids out of the public
        // config/main doc is the whole point — do NOT open this up to client reads.
        match /teamRoster/{docId} {
            allow read, write: if false;
        }

        // Event venues (parking guide data) — publicly readable; writes via Cloud Functions
        match /venues/{venueId} {
            allow read: if true;
        }

        // Parking lots (shared across venues) — publicly readable; writes via Cloud Functions
        match /parkingLots/{lotId} {
            allow read: if true;
        }

        // Parking rate tiers (shared across lots) — publicly readable; writes via Cloud Functions
        match /parkingRates/{rateId} {
            allow read: if true;
        }

        // Managed QR codes — staff+ can read for the admin dashboard / link flow.
        // Public scanners never read these directly; they hit the recordQrScan
        // Cloud Function, which returns the redirect target. All writes (and the
        // scan counters) go through Cloud Functions.
        match /qrCodes/{qrId} {
            allow read: if request.auth != null && isStaffOrAbove();

            // Per-scan events backing the trend charts.
            match /scans/{scanId} {
                allow read: if request.auth != null && isStaffOrAbove();
            }
        }

        // Physical passports. Staff+ read the whole collection for the admin
        // dashboard; an owner may read their own passports (the profile shelf),
        // which is why the shelf query MUST filter on ownerUid — an unfiltered
        // read is rejected. Public scanners never read this: they call
        // getPassportPublicProfile, which resolves the sticker server-side.
        // All writes (status, ownerUid, scan counters) go through Cloud Functions.
        match /passports/{passportId} {
            allow read: if request.auth != null
                && (isStaffOrAbove() || resource.data.ownerUid == request.auth.uid);

            // Permanent bind/void/key-reissue audit trail — no TTL, core-staff+ only.
            match /claims/{claimId} {
                allow read: if request.auth != null && isCoreStaffOrAbove();
            }

            // Per-scan events backing the trend charts.
            match /scans/{scanId} {
                allow read: if request.auth != null && isStaffOrAbove();
            }
        }

        // Activation-key hashes. Server-only, no exceptions — the whole
        // anti-theft story is that an unsold passport's key can't be read off
        // the wire by anyone, including a president. Same treatment as teamRoster.
        match /passportSecrets/{passportId} {
            allow read, write: if false;
        }

        // One passport design per year — cover art, and nothing else. Publicly
        // readable: a signed-out visitor scanning a sticker needs the artwork,
        // and it holds nothing that isn't already printed on the passport.
        match /passportDesigns/{year} {
            allow read: if true;
        }

        // Editable social-platform templates for the QR "Social profile" mode.
        // Only consumed in the admin UI (staff+), never by public scanners; all
        // writes go through Cloud Functions.
        match /socialPlatforms/{platformId} {
            allow read: if request.auth != null && isStaffOrAbove();
        }

        // Deny all access to unlisted paths (safety net — Firestore denies by default,
        // but an explicit rule prevents accidental exposure if new paths are added)
        match /{document=**} {
            allow read, write: if false;
        }
    }
}
