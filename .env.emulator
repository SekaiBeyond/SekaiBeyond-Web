# npm run dev loads this over .env, pointing the site at the local emulators it
# starts instead of production. A demo- project is offline-only, so none of these
# is a real credential, and they must match the emulators' project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sekaibeyond.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sekaibeyond
VITE_FIREBASE_STORAGE_BUCKET=demo-sekaibeyond.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
