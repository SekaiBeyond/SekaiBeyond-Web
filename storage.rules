rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId} {
      // Authenticated users can view any avatar
      allow read: if request.auth != null;

      // Users can delete their own avatar
      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      // Writes only via Cloud Function (uploadAvatar) which enforces:
      // - group != visitor, magic bytes validation, size limit, content type
    }

    match /events/{imageId} {
      // Event images are publicly readable (used on landing page)
      allow read: if true;
      // Writes only via Cloud Function (Admin SDK bypasses rules)
    }

    match /upcoming-events/{imageId} {
      // Upcoming event posters are publicly readable (used on landing page)
      allow read: if true;
      // Writes only via Cloud Function (Admin SDK bypasses rules)
    }

    match /badges/{imageId} {
      // Badge images are publicly readable (shown on profile pages)
      allow read: if true;
      // Writes only via Cloud Function (Admin SDK bypasses rules)
    }
  }
}
