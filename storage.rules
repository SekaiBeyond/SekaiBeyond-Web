rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId} {
      // Authenticated users can view any avatar
      allow read: if request.auth != null;

      // Users can upload their own avatar (max 5MB, images only)
      // Visitor restriction is enforced client-side (Storage rules can't read Firestore)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /events/{imageId} {
      // Event images are publicly readable (used on landing page)
      allow read: if true;

      // Only authenticated users can upload (core-staff check enforced client-side)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
